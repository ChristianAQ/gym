rules_version = '2';

// Cada usuario (autenticado de forma anónima) solo puede leer y escribir
// su propio documento en /users/{uid}, donde GymRat guarda su progreso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
