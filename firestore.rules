rules_version = '2';

// Modelo de datos de GymRat:
//   /users/{uid}                     perfil (racha, récords, resumen de días)
//   /users/{uid}/workouts/{id}        detalle de cada entrenamiento registrado
//   /users/{uid}/friends/{friendUid}  amistades (marcador, sin datos sensibles)
//
// El perfil es legible por cualquier usuario autenticado (así funciona el
// ranking entre amigos sin necesitar un backend propio), pero solo su dueño
// puede escribirlo. La subcolección `friends` se puede escribir desde
// cualquiera de los dos lados de la amistad para que "añadir amigo" sea
// mutuo con una sola operación desde el cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /workouts/{workoutId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }

      // Bandeja de rutinas que otros te han enviado. Solo puede escribirte
      // aquí alguien que ya figura como tu amigo (es decir, con quien ya
      // tienes una amistad mutua registrada) — así "compartir rutina" queda
      // limitado a amigos de verdad, no a cualquier usuario autenticado.
      match /incomingRoutines/{routineId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid));
        allow update: if false;
      }
    }
  }
}
